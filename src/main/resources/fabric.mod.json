	},
	"license": "MIT",
	"environment": "*",
	"languageAdapters": {
		"rust": "io.github.bownlux.fabricrust.RustLanguageAdapter"
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"java": ">=25"
	}
}
