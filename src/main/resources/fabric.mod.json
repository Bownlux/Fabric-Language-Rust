{
	"schemaVersion": 1,
	"id": "fabric-language-rust",
	"version": "${version}",
	"name": "Fabric Language Rust",
	"description": "Fabric language module for Rust. Adds support for writing mod entrypoints in Rust via native cdylibs.",
	"authors": [
		"Bownlux"
	],
	"contact": {
